# Copy this file to .env and fill in the values from your Supabase project
# (Dashboard > Project Settings > API). Both keys are public/client-side by
# design; the real protection is Row Level Security, never these values.
#
# While these are empty the app falls back to the local mock login, so nothing
# breaks before the backend is set up.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Newer Supabase dashboards may call this the publishable key instead.
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional. When omitted, address validation uses the OpenStreetMap geocoder.
# Restrict this browser key to your production domains in Google Cloud.
# VITE_GOOGLE_MAPS_API_KEY=

# Payments (not wired up yet)
# VITE_STRIPE_PUBLISHABLE_KEY=
