# Server-side only. Never expose these values through VITE_* variables.
DEFAULT_PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
APP_URL=http://localhost:8080
# Optional comma-separated exact origins for trusted deploy previews.
# Never use wildcards (for example *.vercel.app).
APP_ALLOWED_ORIGINS=
# Mercado Pago PIX / Marketplace Split 1:1. Keep every value outside the Vite app.
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
MERCADO_PAGO_WEBHOOK_SECRET=...
MERCADO_PAGO_LIVEMODE=false
MERCADO_PAGO_OAUTH_LIVEMODE=false
MERCADO_PAGO_CLIENT_ID=...
MERCADO_PAGO_CLIENT_SECRET=...
MERCADO_PAGO_OAUTH_REDIRECT_URI=https://PROJECT_REF.supabase.co/functions/v1/mercado-pago-oauth-callback
MERCADO_PAGO_WEBHOOK_URL=https://PROJECT_REF.supabase.co/functions/v1/payment-webhook?provider=mercado_pago
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=BASE64URL_32_BYTES
PAYMENT_RATE_LIMIT_PEPPER=RANDOM_MINIMUM_32_CHARACTERS
PAYMENT_OPERATIONS_SECRET=RANDOM_MINIMUM_32_CHARACTERS
MERCADO_PAGO_LIVE_ORGANIZATION_ALLOWLIST=00000000-0000-4000-8000-000000000000
APP_ORIGIN=http://localhost:8080
